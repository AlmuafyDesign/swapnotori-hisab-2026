const SHEETS = {
  members:['id','name','membershipNo','shares','fatherName','phone','address','joinDate','monthlyFee','annualFee','status','createdAt'],
  monthlyPayments:['id','memberId','fiscalYear','month','amount','date','method','notes','receiptNo','createdAt'],
  yearlyPayments:['id','memberId','fiscalYear','amount','date','notes','receiptNo','createdAt'],
  qardHasan:['id','memberId','borrower','amount','date','dueDate','purpose','notes','chairmanApproved','serviceFee','serviceFeePaid','status','receiptNo','createdAt'],
  loanRepayments:['id','loanId','borrower','amount','date','notes','receiptNo','createdAt'],
  investments:['id','name','location','date','initialAmount','status','notes','createdAt'],
  investmentTransactions:['id','investmentId','type','date','amount','description','createdAt'],
  investmentIncome:['id','investmentId','date','amount','description','receiptNo','createdAt'],
  investmentExpenses:['id','investmentId','date','amount','description','createdAt'],
  cashTransactions:['id','date','type','category','description','cashIn','cashOut','method','createdAt'],
  receipts:['id','date','payer','relatedId','type','amount','method','driveFileId','driveUrl','createdAt'],
  settings:['key','value','updatedAt'],
  admin:['email','passwordSalt','passwordHash','createdAt'],
  auditLogs:['id','dateTime','type','recordId','amount','previousValue','newValue','adminEmail']
};
const TAB_NAMES = {
  members:'সদস্য', monthlyPayments:'মাসিক চাঁদা', yearlyPayments:'বার্ষিক চাঁদা', qardHasan:'করজে হাসানা',
  loanRepayments:'ঋণ ফেরত', investments:'বিনিয়োগ', investmentTransactions:'বিনিয়োগ লেনদেন', investmentIncome:'বিনিয়োগ আয়',
  investmentExpenses:'বিনিয়োগ ব্যয়', cashTransactions:'নগদ লেনদেন', receipts:'রসিদ', settings:'সেটিংস', admin:'অ্যাডমিন', auditLogs:'নিরীক্ষা লগ'
};

function doGet(){return HtmlService.createHtmlOutput('<meta name="viewport" content="width=device-width"><p style="font:16px sans-serif">স্বপ্নতরী হিসাব API প্রস্তুত।</p>').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);}
function doPost(e){let req={},result=null,error='';try{req={id:e.parameter.id||'',operation:e.parameter.operation||'',data:JSON.parse(e.parameter.data||'{}'),token:e.parameter.token||''};result=handle_(req);}catch(err){error=String(err&&err.message||err);}const msg=JSON.stringify({id:req.id,result,error:error||undefined}).replace(/</g,'\\u003c');return HtmlService.createHtmlOutput('<!doctype html><meta charset="utf-8"><script>parent.postMessage('+msg+',"*")<\/script>').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);}
function handle_(req){if(req.operation==='login')return login_(req.data);const email=authorize_(req.token);switch(req.operation){case'init':return initialize_();case'dashboard':return dashboard_();case'list':return list_(req.data.table);case'create':return create_(email,req.data.table,req.data.record);case'updateMember':return updateMember_(email,req.data.id,req.data.record);case'settings':return settings_();case'saveSettings':return saveSettings_(email,req.data.values);case'importWorkbook':return importWorkbook_(email,req.data);case'logout':CacheService.getScriptCache().remove('session:'+req.token);return{ok:true};default:throw new Error('অনুমোদিত নয় এমন অনুরোধ।');}}
function login_(data){const props=PropertiesService.getScriptProperties();const dbId=props.getProperty('SPREADSHEET_ID');const adminEmail=(props.getProperty('ADMIN_EMAIL')||'').trim().toLowerCase();if(!dbId||!adminEmail||!props.getProperty('ADMIN_PASSWORD_HASH'))throw new Error('প্রশাসক, পাসওয়ার্ড এবং ডেটাবেস কনফিগারেশন সম্পূর্ণ হয়নি।');const cache=CacheService.getScriptCache(),attemptKey='login-fail:'+hash_(String(data.email||'').trim().toLowerCase());const attempts=Number(cache.get(attemptKey)||0);if(attempts>=5)throw new Error('অনেকবার ভুল চেষ্টা হয়েছে। ১০ মিনিট পরে আবার চেষ্টা করুন।');const salt=props.getProperty('ADMIN_PASSWORD_SALT');if(String(data.email||'').trim().toLowerCase()!==adminEmail||hash_(salt+String(data.password||''))!==props.getProperty('ADMIN_PASSWORD_HASH')){cache.put(attemptKey,String(attempts+1),600);throw new Error('ইমেইল বা পাসওয়ার্ড সঠিক নয়।');}cache.remove(attemptKey);const token=Utilities.getUuid()+Utilities.getUuid();cache.put('session:'+token,adminEmail,21600);initialize_();return{token,expiresIn:21600};}
function hash_(value){return Utilities.base64Encode(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,value,Utilities.Charset.UTF_8));}
function authorize_(token){const email=token&&CacheService.getScriptCache().get('session:'+token);if(!email)throw new Error('সেশন শেষ হয়েছে। আবার প্রবেশ করুন।');if(email!==(PropertiesService.getScriptProperties().getProperty('ADMIN_EMAIL')||'').trim().toLowerCase())throw new Error('অনুমতি নেই।');return email;}
function initialize_(){const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(!id)throw new Error('ডেটাবেস স্প্রেডশিট আইডি সেট করা হয়নি।');const ss=SpreadsheetApp.openById(id);Object.keys(SHEETS).forEach(key=>{let sh=ss.getSheetByName(TAB_NAMES[key]);if(!sh)sh=ss.insertSheet(TAB_NAMES[key]);if(sh.getLastRow()===0)sh.appendRow(SHEETS[key]);});return{ok:true,sheets:Object.keys(SHEETS).length};}
function sheet_(key){if(!SHEETS[key])throw new Error('অজানা হিসাব খাত।');const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');const sh=SpreadsheetApp.openById(id).getSheetByName(TAB_NAMES[key]);if(!sh)throw new Error('ডেটাবেস প্রস্তুত নয়।');return sh;}
function records_(key){const sh=sheet_(key),v=sh.getDataRange().getValues();if(v.length<2)return[];return v.slice(1).filter(r=>r.some(x=>x!==''&&x!==null)).map(r=>Object.fromEntries(SHEETS[key].map((k,i)=>[k,r[i] instanceof Date?Utilities.formatDate(r[i],Session.getScriptTimeZone(),'yyyy-MM-dd'):r[i]])));}
function list_(key){if(['admin','settings'].includes(key))throw new Error('এই তথ্য সরাসরি দেখানো যাবে না।');const rows=records_(key);if(key==='qardHasan'){const payments=records_('loanRepayments');return rows.map(loan=>{const repaid=payments.filter(p=>p.loanId===loan.id).reduce((a,p)=>a+Number(p.amount||0),0);const balance=Math.max(0,Number(loan.amount||0)-repaid);return{...loan,repaid,balance,status:balance===0?'পরিশোধিত':new Date(loan.dueDate)<new Date()?'মেয়াদোত্তীর্ণ':'চলমান'};});}return rows;}
function create_(email,key,record){const allowed=['members','monthlyPayments','yearlyPayments','qardHasan','loanRepayments','investments','investmentTransactions','investmentIncome','investmentExpenses','cashTransactions'];if(!allowed.includes(key))throw new Error('এই ধরনের লেনদেন যোগ করা যাবে না।');const lock=LockService.getScriptLock();lock.waitLock(10000);try{validate_(key,record);if(key==='members')record.status=record.status||'সক্রিয়';if(key==='monthlyPayments'&&records_(key).some(x=>x.memberId===record.memberId&&x.fiscalYear===record.fiscalYear&&x.month===record.month)&&record.additional!==true)throw new Error('এই সদস্যের এই মাসে জমা আছে। অতিরিক্ত জমার জন্য অনুমোদিত অতিরিক্ত লেনদেন চিহ্নিত করুন।');if(key==='qardHasan')validateLoan_(record);const id=Utilities.getUuid();const clean={...record,id,createdAt:new Date().toISOString()};if(key==='investments'){clean.initialAmount=Number(record.amount);delete clean.amount;}delete clean.additional;const receiptNo=['monthlyPayments','yearlyPayments','qardHasan','loanRepayments','investmentIncome','investmentExpenses','cashTransactions'].includes(key)?receiptNumber_():'';if(receiptNo&&SHEETS[key].includes('receiptNo'))clean.receiptNo=receiptNo;sheet_(key).appendRow(SHEETS[key].map(k=>clean[k]??''));const amount=Number(record.amount||0);if(['monthlyPayments','yearlyPayments','loanRepayments','investmentIncome'].includes(key))recordCash_(record.date,'জমা',TAB_NAMES[key],amount,0,record.method||'');if(key==='qardHasan')recordCash_(record.date,'করজে হাসানা ও সার্ভিস ফি','করজে হাসানা প্রদান',100,amount,'');if(key==='investmentExpenses')recordCash_(record.date,'বিনিয়োগ ব্যয়',record.description,0,amount,'');if(key==='investments')recordCash_(record.date,'বিনিয়োগ মূলধন',record.name,0,amount,'');if(key==='investmentTransactions'&&record.type==='অতিরিক্ত বিনিয়োগ')recordCash_(record.date,'বিনিয়োগ মূলধন',record.description,0,amount,'');if(key==='investmentTransactions'&&record.type==='মূলধন ফেরত')recordCash_(record.date,'বিনিয়োগ থেকে মূলধন ফেরত',record.description,amount,0,'');audit_(email,'নতুন '+TAB_NAMES[key],id,amount,'',JSON.stringify(clean));let receiptUrl='';if(receiptNo){try{receiptUrl=makeReceipt_(receiptNo,key,record,id);}catch(err){audit_(email,'রসিদ তৈরি ব্যর্থ',id,amount,'',String(err));}}return{id,receiptNo,receiptUrl};}finally{lock.releaseLock();}}
function validate_(key,r){if(!r||typeof r!=='object')throw new Error('তথ্য পাওয়া যায়নি।');if(key==='members'){if(!r.name||!r.membershipNo||!(Number(r.shares)>0))throw new Error('সদস্যের নাম, মেম্বারশিপ নম্বর ও শেয়ার সংখ্যা দিন।');if(records_('members').some(x=>x.membershipNo===r.membershipNo))throw new Error('এই মেম্বারশিপ নম্বর আগে ব্যবহার হয়েছে।');return;}if(key==='qardHasan'||key==='investments'){if(!r.borrower&&!r.name||!(Number(r.amount)>0))throw new Error('নাম/প্রকল্প ও সঠিক পরিমাণ দিন।');return;}if(key==='loanRepayments'){const loan=records_('qardHasan').find(x=>x.id===r.loanId);if(!loan)throw new Error('ঋণের রেকর্ড পাওয়া যায়নি।');const paid=records_('loanRepayments').filter(x=>x.loanId===r.loanId).reduce((a,x)=>a+Number(x.amount||0),0);if(Number(r.amount)>Number(loan.amount)-paid)throw new Error('ফেরতের পরিমাণ অবশিষ্ট ঋণের চেয়ে বেশি।');return;}if(['monthlyPayments','yearlyPayments'].includes(key)&&!records_('members').some(x=>x.id===r.memberId))throw new Error('সদস্যের রেকর্ড পাওয়া যায়নি।');if(!r.date||!(Number(r.amount)>0))throw new Error('তারিখ ও শূন্যের বেশি পরিমাণ দিন।');}
function validateLoan_(r){if(Number(r.amount)>15000)throw new Error('সংবিধান অনুযায়ী করজে হাসানা সর্বোচ্চ ১৫,০০০ টাকা।');if(r.chairmanApproved!==true&&String(r.chairmanApproved)!=='true')throw new Error('করজে হাসানা প্রদানের আগে চেয়ারম্যানের অনুমোদন নথিভুক্ত করুন।');if(r.serviceFeePaid!==true&&String(r.serviceFeePaid)!=='true')throw new Error('আবেদনের ১০০ টাকার সার্ভিস ফি গ্রহণ নিশ্চিত করুন।');const start=new Date(r.date),due=new Date(r.dueDate);if(!(due>start)||due>new Date(start.getFullYear(),start.getMonth()+2,start.getDate()))throw new Error('করজে হাসানার মেয়াদ সর্বোচ্চ ২ মাস।');const member=records_('members').find(x=>x.id===r.memberId);if(!member||member.status==='নিষ্ক্রিয়')throw new Error('সক্রিয় সদস্যের ID দিন।');const year=r.fiscalYear||settings_().fiscalYear||'2026-27';const months=['জুন','জুলাই','আগস্ট','সেপ্টেম্বর','অক্টোবর','নভেম্বর','ডিসেম্বর','জানুয়ারি','ফেব্রুয়ারি','মার্চ','এপ্রিল','মে'];const payments=records_('monthlyPayments').filter(p=>p.memberId===r.memberId);const fee=Number(member.monthlyFee||0);const monthIndex=(start.getMonth()+7)%12;const recent=[months[(monthIndex+11)%12],months[monthIndex]];if(recent.some(m=>payments.filter(p=>p.fiscalYear===year&&p.month===m).reduce((s,p)=>s+Number(p.amount||0),0)<fee))throw new Error('সর্বশেষ দুই মাসের মাসিক চাঁদা পরিশোধিত নয়।');const annualPaid=records_('yearlyPayments').filter(p=>p.memberId===r.memberId&&p.fiscalYear===year).reduce((s,p)=>s+Number(p.amount||0),0);if(annualPaid<Number(member.annualFee||0))throw new Error('চলতি অর্থবছরের বার্ষিক ফি পরিশোধিত নয়।');const prior=records_('qardHasan').filter(l=>l.memberId===r.memberId);const priorPayments=records_('loanRepayments');if(prior.some(l=>Number(l.amount||0)-priorPayments.filter(p=>p.loanId===l.id).reduce((s,p)=>s+Number(p.amount||0),0)>0))throw new Error('আগের করজে হাসানা পরিশোধের আগে নতুন আবেদন করা যাবে না।');r.status='চলমান';r.serviceFee=100;}
function updateMember_(email,id,record){const lock=LockService.getScriptLock();lock.waitLock(10000);try{const sh=sheet_('members'),rows=sh.getDataRange().getValues(),i=rows.findIndex((r,n)=>n>0&&r[0]===id);if(i<1)throw new Error('সদস্য পাওয়া যায়নি।');const old=Object.fromEntries(SHEETS.members.map((k,c)=>[k,rows[i][c]]));const next={...old,...record,id};const tx=['monthlyPayments','yearlyPayments','qardHasan','loanRepayments'].some(k=>records_(k).some(x=>x.memberId===id));if(tx&&record.status==='নিষ্ক্রিয়'){}else if(tx&&record._delete)throw new Error('লেনদেন থাকা সদস্য স্থায়ীভাবে মুছতে পারবেন না; নিষ্ক্রিয় করুন।');else if(record._delete)throw new Error('সদস্য স্থায়ীভাবে মুছবেন না; নিষ্ক্রিয় করুন।');delete next._delete;sh.getRange(i+1,1,1,SHEETS.members.length).setValues([SHEETS.members.map(k=>next[k]??'')]);audit_(email,'সদস্য তথ্য সংশোধন',id,0,JSON.stringify(old),JSON.stringify(next));return{ok:true};}finally{lock.releaseLock();}}
function dashboard_(){const cfg=settings_(),members=records_('members'),fy=String(cfg.fiscalYear||''),monthly=records_('monthlyPayments'),yearly=records_('yearlyPayments'),loans=list_('qardHasan'),repays=records_('loanRepayments'),inc=records_('investmentIncome'),exp=records_('investmentExpenses'),investments=records_('investments'),invest=records_('investmentTransactions'),cash=records_('cashTransactions'),active=members.filter(x=>x.status!=='নিষ্ক্রিয়'),fyMonthly=monthly.filter(x=>String(x.fiscalYear)===fy),fyYearly=yearly.filter(x=>String(x.fiscalYear)===fy),paidMonthly=sum_(fyMonthly),paidYearly=sum_(fyYearly),monthCount=Number(cfg.monthsDueCount||0),dueMonthly=Math.max(0,active.reduce((s,m)=>s+Number(m.monthlyFee||0)*monthCount,0)-paidMonthly),dueYearly=Math.max(0,active.reduce((s,m)=>s+Number(m.annualFee||0),0)-paidYearly),repaid=sum_(repays),outstanding=loans.reduce((s,l)=>s+Number(l.balance||0),0),capital=investments.reduce((s,x)=>s+Number(x.initialAmount||0),0)+invest.filter(x=>x.type==='অতিরিক্ত বিনিয়োগ').reduce((s,x)=>s+Number(x.amount||0),0),cashIn=sumBy_(cash,'cashIn'),cashOut=sumBy_(cash,'cashOut');return{members:members.length,activeMembers:active.length,monthlyTotal:paidMonthly,monthlyDue:dueMonthly,yearlyTotal:paidYearly,yearlyDue:dueYearly,monthlyPaidMembers:new Set(fyMonthly.map(x=>x.memberId)).size,yearlyPaidMembers:new Set(fyYearly.map(x=>x.memberId)).size,qardDisbursed:sum_(loans),qardRepaid:repaid,qardOutstanding:outstanding,investmentIncome:sum_(inc),investmentExpenses:sum_(exp),investmentProfit:sum_(inc)-sum_(exp),investmentCapital:capital,cashBalance:Number(cfg.openingCash||0)+cashIn-cashOut,cashIn,cashOut,recent:monthly.slice(-5).reverse()};}
function sum_(rows){return rows.reduce((a,x)=>a+Number(x.amount||0),0)}function sumBy_(rows,key){return rows.reduce((a,x)=>a+Number(x[key]||0),0)}
function settings_(){return Object.fromEntries(records_('settings').map(x=>[x.key,x.value]));}
function receiptNumber_(){return 'ST-'+Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyyMMdd-HHmmss')+'-'+Utilities.getUuid().slice(0,5).toUpperCase();}
function recordCash_(date,type,description,cashIn,cashOut,method){sheet_('cashTransactions').appendRow([Utilities.getUuid(),date||new Date(),type,'',description,Number(cashIn||0),Number(cashOut||0),method||'',new Date()]);}
function makeReceipt_(number,key,record,relatedId){const member=record.memberId?records_('members').find(x=>x.id===record.memberId):null;const amount=Number(record.amount||0);const folderProp=PropertiesService.getScriptProperties();let folderId=folderProp.getProperty('RECEIPT_FOLDER_ID'),folder;if(folderId)folder=DriveApp.getFolderById(folderId);else{folder=DriveApp.createFolder('স্বপ্নতরী — রসিদ');folderProp.setProperty('RECEIPT_FOLDER_ID',folder.getId());}const doc=DocumentApp.create(number);const body=doc.getBody();body.appendParagraph('স্বপ্নতরী').setHeading(DocumentApp.ParagraphHeading.TITLE);body.appendParagraph('শেয়ার ভিত্তিক ব্যবসা প্রতিষ্ঠান').setAlignment(DocumentApp.HorizontalAlignment.CENTER);body.appendParagraph('রসিদ: '+number).setHeading(DocumentApp.ParagraphHeading.HEADING2);body.appendParagraph('গ্রহণকারী/সদস্য: '+(member?member.name:record.borrower||record.payer||'—'));if(member)body.appendParagraph('মেম্বারশিপ নম্বর: '+member.membershipNo);body.appendParagraph('লেনদেনের ধরন: '+(TAB_NAMES[key]||key));body.appendParagraph('পরিমাণ: ৳ '+amount.toLocaleString('bn-BD'));body.appendParagraph('তারিখ: '+(record.date||''));body.appendParagraph('বিবরণ: '+(record.description||record.purpose||record.notes||''));body.appendParagraph('\n\nঅনুমোদিত প্রশাসকের স্বাক্ষর: __________________');doc.saveAndClose();const blob=DriveApp.getFileById(doc.getId()).getAs(MimeType.PDF).setName(number+'.pdf');const pdf=folder.createFile(blob);DriveApp.getFileById(doc.getId()).setTrashed(true);const sh=sheet_('receipts');sh.appendRow([number,record.date||new Date(),member?member.name:record.borrower||'',relatedId,key,amount,record.method||'',pdf.getId(),pdf.getUrl(),new Date()]);const spec=SHEETS[key],receiptCol=spec.indexOf('receiptNo');if(receiptCol>=0){const data=sheet_(key).getDataRange().getValues();const index=data.findIndex((r,i)=>i>0&&r[0]===relatedId);if(index>0)sheet_(key).getRange(index+1,receiptCol+1).setValue(number);}return pdf.getUrl();}
function importWorkbook_(email,data){const lock=LockService.getScriptLock();lock.waitLock(10000);try{const keys=['members','monthlyPayments','yearlyPayments'];if(!data||!Array.isArray(data.members)||data.members.length!==25)throw new Error('আমদানি ফাইলে ২৫ জন সদস্য থাকা আবশ্যক।');if(keys.some(k=>records_(k).length)||records_('cashTransactions').length)throw new Error('ডেটাবেসে সদস্য, চাঁদা বা নগদ লেনদেন আছে; পুনরায় আমদানি করা যাবে না।');const memberIds=new Set(data.members.map(x=>x.id));if(data.monthlyPayments.some(x=>!memberIds.has(x.memberId))||data.yearlyPayments.some(x=>!memberIds.has(x.memberId)))throw new Error('আমদানি ফাইলে সদস্য-লেনদেনের পরিচয় মেলেনি।');keys.forEach(key=>{const list=data[key]||[];if(!list.length)return;const rows=list.map(record=>SHEETS[key].map(k=>record[k]??''));sheet_(key).getRange(2,1,rows.length,SHEETS[key].length).setValues(rows);});Object.entries(data.settings||{}).forEach(([key,value])=>sheet_('settings').appendRow([key,value,new Date()]));const receipts=[...data.monthlyPayments.map(x=>({id:x.id,date:'',category:'মাসিক চাঁদা',description:x.memberId,cashIn:x.amount})),...data.yearlyPayments.map(x=>({id:x.id,date:'',category:'বার্ষিক চাঁদা',description:x.memberId,cashIn:x.amount}))];if(receipts.length){const rows=receipts.map(x=>[x.id,x.date,'ঐতিহাসিক জমা',x.category,x.description,Number(x.cashIn),0,'',new Date()]);sheet_('cashTransactions').getRange(2,1,rows.length,SHEETS.cashTransactions.length).setValues(rows);}audit_(email,'পুরোনো হিসাব আমদানি','workbook',receipts.length,'','২৫ সদস্য');return{members:data.members.length,monthlyPayments:data.monthlyPayments.length,yearlyPayments:data.yearlyPayments.length};}finally{lock.releaseLock();}}
function saveSettings_(email,values){const sh=sheet_('settings'),rows=sh.getDataRange().getValues(),at=Object.fromEntries(rows.slice(1).map((r,i)=>[r[0],i+2]));const current=Object.fromEntries(rows.slice(1).map(r=>[r[0],r[1]]));if(new Date()<=new Date('2029-06-30')&&Number(values.annualPerShare)!==Number(current.annualPerShare||5000))throw new Error('সংবিধান অনুযায়ী ২০২৯ সালের জুন পর্যন্ত বার্ষিক ফি ৫,০০০ টাকা; পরিবর্তনে সাধারণ পরিষদের সিদ্ধান্ত প্রয়োজন।');Object.entries(values||{}).forEach(([key,value])=>{if(at[key])sh.getRange(at[key],2).setValue(value);else sh.appendRow([key,value,new Date()]);});audit_(email,'সেটিংস পরিবর্তন','','', '',JSON.stringify(values));return{ok:true};}
function audit_(email,type,id,amount,oldValue,newValue){sheet_('auditLogs').appendRow([Utilities.getUuid(),new Date(),type,id,amount,oldValue,newValue,email]);}
function configureAdmin(){const ui=SpreadsheetApp.getUi(),p=PropertiesService.getScriptProperties();if(!p.getProperty('SPREADSHEET_ID'))throw new Error('Script Properties-এ SPREADSHEET_ID সেট করুন।');const email=(p.getProperty('ADMIN_EMAIL')||'').trim().toLowerCase();if(!/^\S+@gmail\.com$/.test(email))throw new Error('Script Properties-এ বৈধ ADMIN_EMAIL সেট করুন।');const first=ui.prompt('প্রথম প্রশাসক পাসওয়ার্ড','কমপক্ষে ১৪ অক্ষরের নতুন পাসওয়ার্ড লিখুন। এটি শিট বা কোডে সংরক্ষণ হবে না।',ui.ButtonSet.OK_CANCEL);if(first.getSelectedButton()!==ui.Button.OK)return;const password=first.getResponseText();if(password.length<14)throw new Error('পাসওয়ার্ড কমপক্ষে ১৪ অক্ষরের হতে হবে।');const salt=Utilities.getUuid()+Utilities.getUuid();p.setProperties({ADMIN_PASSWORD_SALT:salt,ADMIN_PASSWORD_HASH:hash_(salt+password)});initialize_();}
function createDatabase(){const ss=SpreadsheetApp.create('স্বপ্নতরী — নিরাপদ হিসাব ডেটাবেস');PropertiesService.getScriptProperties().setProperty('SPREADSHEET_ID',ss.getId());initialize_();return ss.getUrl();}
