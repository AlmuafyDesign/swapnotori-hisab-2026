{
  "hosting": {
    "site": "swapnotori-hisab-2026",
    "public": "site",
    "ignore": ["firebase.json", ".firebaserc", "**/.*", "**/node_modules/**", "**/*.example"],
    "cleanUrls": true,
    "headers": [
      {"source":"/service-worker.js","headers":[{"key":"Cache-Control","value":"no-cache"}]},
